{
  "id": "luke-aoa-async",
  "name": "Luke Async Tasks",
  "description": "Isolated QQ and DingTalk async tasks",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["routes"],
    "properties": {
      "routes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["channel", "account", "to"],
          "additionalProperties": false,
          "properties": {
            "channel": { "enum": ["qqbot", "ddingtalk"] },
            "account": { "type": "string" },
            "to": { "type": "string" },
            "windowReply": {
              "type": "object",
              "required": ["agentId"],
              "additionalProperties": false,
              "properties": {
                "agentId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
                "seconds": { "type": "integer", "minimum": 10, "maximum": 120 }
              }
            }
          }
        }
      }
    }
  }
}
