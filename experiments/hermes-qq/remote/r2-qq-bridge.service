[Unit]
Description=R2 Hermes QQ bridge
Wants=r2-qq-receive.service r2-hermes-qq@chat.service r2-hermes-qq@work.service
After=r2-qq-receive.service r2-hermes-qq@chat.service r2-hermes-qq@work.service

[Service]
EnvironmentFile=%h/.local/share/r2-qq-hermes/deploy.env
UMask=0077
ExecStart=/usr/bin/env ${LUKE_NODE} %h/.local/share/r2-qq-hermes/code/experiments/hermes-qq/trial.mjs %h/.local/share/r2-qq-hermes/inbox ${LUKE_QQ_SDK} ${LUKE_QQ_APP_ID} %h/.local/share/r2-qq-hermes/secrets/qq-app-secret r2-hermes-qq-chat --always r2-hermes-qq-work
Restart=always
RestartSec=10
TimeoutStopSec=35

[Install]
WantedBy=default.target
