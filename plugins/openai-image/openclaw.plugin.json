{
  "id": "luke-openai-image",
  "name": "Luke OpenAI Image",
  "description": "Scope-gated OpenAI image and GIF generation",
  "activation": {
    "onStartup": true
  },
  "skills": ["./skills"],
  "contracts": {
    "tools": ["luke_imagen"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxConcurrentJobs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 4
      },
      "allowedGroups": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string" }
      },
      "allowAllDingTalkGroups": {
        "type": "boolean",
        "default": false
      }
    }
  }
}
