[Unit]
Description=OpenClaw dedicated OpenAI Images proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.openclaw/openai-image-private/proxy
ExecStart=%h/.openclaw/bin/mihomo -d %h/.openclaw/openai-image-private/proxy -f %h/.openclaw/openai-image-private/proxy/config.json
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=10
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
